<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal entitlements applied by tool/build_macos_desktop.sh when it
  (re)signs the built .app (plan 69).

  The desktop build is produced with CODE_SIGNING_ALLOWED=NO, so the
  xcodebuild output is unsigned and carries no entitlements at all;
  whatever the signing step passes here is the app's entire
  entitlement set. That set is deliberately minimal:

  - keychain-access-groups must NEVER appear here: an app whose
    signature contains it is refused by launchd at spawn time
    (plan 47). Credential storage uses the legacy login keychain
    and does not need it.
  - com.apple.security.files.user-selected.read-only is required by
    file_picker's macOS plugin: before showing any open panel it
    checks the running process for this (or the read-write variant)
    entitlement and returns ENTITLEMENT_NOT_FOUND without opening
    anything when neither is present (plan 69). The app only ever
    reads files the user picked (certificate / key / credentials.env),
    so read-only is the right scope.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
