   libvorbis = callPackage ../mk-pkg-libvorbis/default.nix { };
   libvpx = callPackage ../mk-pkg-libvpx/default.nix { };
   libx264 = callPackage ../mk-pkg-libx264/default.nix { };
@@ -66,6 +69,7 @@ pkgs.stdenvNoCC.mkDerivation {
     pkgs.meson
     pkgs.ninja
     pkgs.pkg-config
+    xctoolchainInstallNameTool
   ];
   buildInputs =
     [ mbedtls ]
@@ -75,6 +79,11 @@ pkgs.stdenvNoCC.mkDerivation {
     ++ pkgs.lib.optionals (variant == variants.video) [
       dav1d
       libxml2
+      aribb24
+      # aribb24's .pc has "Requires: libpng" (DRCS is enabled in
+      # this stack), so libpng must be visible to ffmpeg's
+      # pkg-config checks and to the static link.
+      libpng
     ]
     ++ pkgs.lib.optionals (variant == variants.video && flavor == flavors.encodersgpl) [
       libvpx
@@ -98,5 +107,23 @@ pkgs.stdenvNoCC.mkDerivation {
 
     # copy configure.log
     cp configure.log $out/share/ffmpeg/
+
+    # Current Xcode SDKs declare the Swift-overlay symbols that moved
+    # into CoreMedia as "$ld$previous$" entries pointing at
+    # libswiftCoreMedia. When ffmpeg links -framework CoreMedia with a
+    # deployment target below the move, ld records a load command for
+    # that previous library (@rpath/libswiftCoreMedia.dylib) *instead
+    # of* CoreMedia itself. ffmpeg references none of the Swift-overlay
+    # symbols (verified with nm -u: zero Swift-mangled undefined
+    # symbols in the ffmpeg libraries), so the recorded dependency is
+    # spurious; restore the real CoreMedia dependency here, at the
+    # package level, before anything downstream (mpv, the framework
+    # packaging in mk-out-frameworks) consumes these dylibs.
+    for lib in $out/lib/*.dylib; do
+      if [ -f "$lib" ] && [ ! -L "$lib" ] && grep -q "@rpath/libswiftCoreMedia.dylib" "$lib"; then
+        install_name_tool -change "@rpath/libswiftCoreMedia.dylib" \
+          "/System/Library/Frameworks/CoreMedia.framework/CoreMedia" "$lib"
+      fi
+    done
   '';
 }
