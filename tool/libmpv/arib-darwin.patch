diff --git a/nix/packages/mk-pkg-aribb24/default.nix b/nix/packages/mk-pkg-aribb24/default.nix
new file mode 100644
index 0000000..9d87423
--- /dev/null
+++ b/nix/packages/mk-pkg-aribb24/default.nix
@@ -0,0 +1,138 @@
+{
+  pkgs ? import ../../utils/default/pkgs.nix,
+  os ? import ../../utils/default/os.nix,
+  arch ? pkgs.callPackage ../../utils/default/arch.nix { },
+}:
+
+let
+  name = "aribb24";
+  packageLock = (import ../../../packages.lock.nix).${name};
+  inherit (packageLock) version;
+
+  callPackage = pkgs.lib.callPackageWith { inherit pkgs os arch; };
+
+  libpng = callPackage ../mk-pkg-libpng/default.nix { };
+
+  pname = import ../../utils/name/package.nix name;
+  src = callPackage ../../utils/fetch-tarball/default.nix {
+    name = "${pname}-source-${version}";
+    inherit (packageLock) url sha256;
+  };
+  patchedSource = pkgs.runCommand "${pname}-patched-source-${version}" { } ''
+    cp -r ${src} src
+    export src=$PWD/src
+    chmod -R 777 $src
+
+    cd $src
+    # Same two source adjustments as the Android build
+    # (tool/libmpv/arib-android.patch):
+    #
+    # 1. Label the master snapshot 1.0.4. Upstream master still says
+    #    1.0.3 in AC_INIT, but FFmpeg 6.0's non-GPL configuration
+    #    requires pkg-config "aribb24 > 1.0.3": the check exists
+    #    because the 1.0.3 tag was GPLv3 while master relicensed to
+    #    LGPLv3 (commit ed79dab) and carries further fixes. The code
+    #    is otherwise unmodified upstream master.
+    sed -i 's/AC_INIT(\[aribb24\], \[1.0.3\]/AC_INIT([aribb24], [1.0.4]/' configure.ac
+    # 2. Make libpng genuinely optional: the stock PKG_CHECK_MODULES
+    #    call has an empty not-found action, which recent pkg.m4
+    #    treats as a fatal error. libpng only backs DRCS glyph
+    #    rendering; when it is present (it is, via mk-pkg-libpng)
+    #    this branch never runs.
+    sed -i 's/^], \[\])$/], [PNG_CFLAGS=""; PNG_LIBS=""])/' configure.ac
+    cd -
+
+    cp -r $src $out
+  '';
+
+  oses = import ../../utils/constants/oses.nix;
+  archs = import ../../utils/constants/archs.nix;
+
+  # Autotools needs the cross values in shell form. These mirror
+  # cross-files/<os>-<arch>.ini, which remains the source of truth
+  # for the meson-based packages.
+  platform =
+    if os == oses.ios then
+      "iPhoneOS"
+    else if os == oses.iossimulator then
+      "iPhoneSimulator"
+    else if os == oses.macos then
+      "MacOSX"
+    else
+      abort "Os ${os} is not supported";
+  clangArch = if arch == archs.amd64 then "x86_64" else "arm64";
+  minVersion =
+    if os == oses.macos then
+      "-mmacosx-version-min=10.9"
+    else if os == oses.iossimulator && arch == archs.arm64 then
+      "-miphoneos-version-min=12.0"
+    else
+      "-miphoneos-version-min=9.0";
+  targetFlag =
+    if os == oses.iossimulator && arch == archs.arm64 then
+      "-target arm64-apple-ios-simulator"
+    else
+      "";
+  hostTriple = "${clangArch}-apple-darwin";
+
+  xcode = pkgs.darwin.xcode;
+  toolchain = "${xcode}/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin";
+  sdk = "${xcode}/Contents/Developer/Platforms/${platform}.platform/Developer/SDKs/${platform}.sdk";
+  commonFlags = "-arch ${clangArch} -isysroot ${sdk} ${minVersion} ${targetFlag}";
+in
+
+pkgs.stdenvNoCC.mkDerivation {
+  name = "${pname}-${os}-${arch}-${version}";
+  pname = pname;
+  inherit version;
+  src = patchedSource;
+  dontUnpack = true;
+  enableParallelBuilding = true;
+  nativeBuildInputs = [
+    # Not autoreconfHook: its autoreconfPhase would run at the build
+    # root before configurePhase copies the source into place (this
+    # derivation uses dontUnpack with a manual copy). ./bootstrap in
+    # configurePhase runs autoreconf itself, so it only needs the
+    # tools on PATH.
+    pkgs.autoconf
+    pkgs.automake
+    pkgs.libtool
+    pkgs.pkg-config
+    pkgs.gnumake
+  ];
+  buildInputs = [
+    # Present in the darwin stack, so DRCS glyph rendering via
+    # libpng stays enabled (unlike the Android build).
+    libpng
+  ];
+  configurePhase = ''
+    cp -r $src src
+    chmod -R u+w src
+    cd src
+
+    ./bootstrap
+
+    mkdir -p _build
+    cd _build
+    ../configure \
+      --host=${hostTriple} \
+      --prefix=$out \
+      --enable-static \
+      --disable-shared \
+      CC="${toolchain}/clang ${commonFlags}" \
+      CXX="${toolchain}/clang++ ${commonFlags}" \
+      AR="${toolchain}/ar" \
+      RANLIB="${toolchain}/ranlib" \
+      NM="${toolchain}/nm" \
+      STRIP="${toolchain}/strip"
+  '';
+  # stdenv runs all phases in one shell, so the working directory
+  # persists: configurePhase ends inside src/_build, which is exactly
+  # where these phases need to run.
+  buildPhase = ''
+    make
+  '';
+  installPhase = ''
+    make install
+  '';
+}
