diff --git a/nix/packages/mk-pkg-libpng/default.nix b/nix/packages/mk-pkg-libpng/default.nix
index 9a5fafd..0e50fca 100644
--- a/nix/packages/mk-pkg-libpng/default.nix
+++ b/nix/packages/mk-pkg-libpng/default.nix
@@ -39,6 +39,14 @@ let
         unzip ${libpngPatch} -d libpng-patch
         rsync -a libpng-patch/libpng-*/ $src/
 
+        # pngpriv.h includes the long-removed Classic Mac OS header
+        # <fp.h> when TARGET_OS_MAC is defined (clang defines it for
+        # every Apple target) and <math.h> has not been included yet.
+        # No current Apple SDK ships fp.h; math.h is the correct
+        # replacement on all modern Apple platforms.
+        sed -i "s|#      include <fp.h>|#      include <math.h>|" $src/pngpriv.h
+        grep -n "include <math.h>" $src/pngpriv.h | head -3
+
         cp -r $src $out
       '';
 in
