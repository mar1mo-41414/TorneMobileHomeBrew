index 060869c..eb16111 100644
--- a/nix/packages/mk-pkg-ffmpeg/default.nix
+++ b/nix/packages/mk-pkg-ffmpeg/default.nix
@@ -24,9 +24,12 @@ let
   };
   nativeFile = callPackage ../../utils/native-file/default.nix { };
   crossFile = callPackage ../../utils/cross-file/default.nix { };
