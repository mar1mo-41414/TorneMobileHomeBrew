diff --git a/buildscripts/scripts/libaribb24.sh b/buildscripts/scripts/libaribb24.sh
new file mode 100755
index 0000000..dc8dbd6
--- /dev/null
+++ b/buildscripts/scripts/libaribb24.sh
@@ -0,0 +1,48 @@
+#!/bin/bash -e
+
+. ../../include/depinfo.sh
+. ../../include/path.sh
+
+build=_build$ndk_suffix
+
+if [ "$1" == "build" ]; then
+	true
+elif [ "$1" == "clean" ]; then
+	rm -rf $build
+	[ -f Makefile ] && make distclean || true
+	exit 0
+else
+	exit 255
+fi
+
+# Upstream master is still labelled 1.0.3 in AC_INIT, but FFmpeg 6.0's
+# non-GPL configuration requires pkg-config "aribb24 > 1.0.3": the check
+# exists because the 1.0.3 tag was GPLv3 while master relicensed to
+# LGPLv3 (commit ed79dab) and carries further fixes. Label this master
+# snapshot 1.0.4 so the check expresses its intent. Code is otherwise
+# unmodified upstream master.
+sed -i 's/AC_INIT(\[aribb24\], \[1.0.3\]/AC_INIT([aribb24], [1.0.4]/' configure.ac
+
+# Make libpng genuinely optional: the stock PKG_CHECK_MODULES call has an
+# empty not-found action, which pkg.m4 treats as "error out". libpng only
+# backs DRCS glyph rendering and is absent from the NDK sysroot.
+sed -i 's/^], \[\])$/], [PNG_CFLAGS=""; PNG_LIBS=""])/' configure.ac
+
+./bootstrap
+
+# Build out-of-tree per architecture: an in-tree build would silently
+# reuse the previous architecture's objects on the next arch pass.
+[ -f Makefile ] && make distclean || true
+mkdir -p $build
+cd $build
+
+# CC/CXX/AR/RANLIB and the toolchain PATH come from build.sh + path.sh.
+# libpng is absent in the NDK sysroot, so DRCS PNG support auto-disables.
+../configure \
+	--host=$ndk_triple \
+	--prefix=/usr/local \
+	--enable-static \
+	--disable-shared
+
+make -j$cores
+make DESTDIR="$prefix_dir" install
